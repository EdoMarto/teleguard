# Telegram bot token from @BotFather. Add the bot to your group as an admin
# with "ban users", "delete messages" and "restrict members" permissions.
TELEGRAM_BOT_TOKEN=

# Join CAPTCHA
CAPTCHA_TIMEOUT=60

# Anti-flood: FLOOD_MAX messages within FLOOD_SECONDS gets a mute
FLOOD_MAX=5
FLOOD_SECONDS=5

# Warnings before an automatic ban
WARN_LIMIT=3

# Risk score (profile) at which a new member gets a harder challenge
RISK_THRESHOLD=4
# Datacenters you consider suspicious, e.g. "4 5" (weak signal, off by default)
SUSPICIOUS_DATACENTERS=

WELCOME_TEXT=Benvenuto/a nel gruppo! 👋
